# Public Supabase project URL; required for authentication.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anonymous key; access must be restricted by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only OpenRouter credential; unused in Phase 1.
OPENROUTER_API_KEY=
# Server-only personal Gmail sender address.
GMAIL_USER=
# Server-only Google OAuth client ID for Gmail.
GMAIL_OAUTH_CLIENT_ID=
# Server-only Google OAuth client secret for Gmail.
GMAIL_OAUTH_CLIENT_SECRET=
# Server-only Gmail OAuth refresh token with https://mail.google.com/ scope.
GMAIL_OAUTH_REFRESH_TOKEN=
# Server-only unencrypted RSA OpenPGP armored private key; literal \n or real newlines supported.
LOGIN_CODE_PRIVATE_KEY=
