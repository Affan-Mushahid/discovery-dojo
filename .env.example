# Public Supabase project URL; reserved for the next phase.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anonymous key; access must be restricted by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only OpenRouter credential; unused in Phase 1.
OPENROUTER_API_KEY=
# Server-only Gmail sender address; unused in Phase 1.
GMAIL_USER=
# Server-only Google OAuth client ID for Gmail; unused in Phase 1.
GMAIL_OAUTH_CLIENT_ID=
# Server-only Google OAuth client secret for Gmail; unused in Phase 1.
GMAIL_OAUTH_CLIENT_SECRET=
# Server-only Gmail OAuth refresh token; unused in Phase 1.
GMAIL_OAUTH_REFRESH_TOKEN=
